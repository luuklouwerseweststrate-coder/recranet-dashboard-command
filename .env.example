# Frontend, in Vercel
VITE_API_BASE_URL=https://recranet-dashboard-api.onrender.com

# Backend, in Render
NODE_ENV=production
FRONTEND_ORIGIN=https://recranet-dashboard.vercel.app
ALLOWED_ORIGINS=https://recranet-dashboard.vercel.app,https://dashboard.jouwdomein.nl
ADMIN_PASSWORD=maak-hier-een-lang-uniek-beheer-wachtwoord
CLIENT_PASSWORD=maak-hier-een-lang-uniek-klant-wachtwoord
COOKIE_SAME_SITE=None
SYNC_INTERVAL_MS=600000

# Nodig voor live GA4/Search Console sync op Render.
GOOGLE_REFRESH_TOKEN=plak-refresh-token-uit-lokale-google-setup
GOOGLE_CLIENT_ID=plak-google-oauth-client-id
GOOGLE_CLIENT_SECRET=plak-google-oauth-client-secret

# Optioneel: zet data buiten server/data als je een persistent disk of database-adapter toevoegt.
DATA_DIR=/var/data/recranet-dashboard
